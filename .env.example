PORT=4000
MONGODB_URI=mongodb://localhost:27017/node-auth-mailer
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Mailtrap Sandbox (email over HTTPS API, works on Render where SMTP ports are blocked)
# Token and inbox ID: Sandboxes > your inbox > Integration > API.
# Emails are caught in that test inbox, not delivered. Any EMAIL_FROM works.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Node Auth App

# Flutterwave (sandbox). https://app.flutterwave.com > Settings > API Keys, with Test mode ON.
# Use the TEST secret key (FLWSECK_TEST-...): no real money moves.
FLW_SECRET_KEY=
FLW_CURRENCY=RWF
# Where Flutterwave sends the customer back after paying (the React app)
FRONTEND_URL=http://localhost:5173
