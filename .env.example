PORT=4000
MONGODB_URI=mongodb://localhost:27017/node-auth-mailer
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Gmail SMTP: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it below (no spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
