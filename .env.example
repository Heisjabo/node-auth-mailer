PORT=4000
MONGODB_URI=mongodb://localhost:27017/node-auth-mailer
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Brevo (email over HTTPS API, works on Render where SMTP ports are blocked)
# API key: Brevo dashboard > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=
# Must be a verified sender: Brevo dashboard > Senders, Domains & Dedicated IPs > Senders
EMAIL_FROM=
EMAIL_FROM_NAME=Node Auth App
